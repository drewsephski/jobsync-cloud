      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary actions use blue and ambient depth.",
      "html": "<button class=\"ds-primary\">Save changes</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:400 14px/20px var(--font-sans,Geist,sans-serif);border-radius:var(--radius-base,12px);height:40px;padding:8px 16px;cursor:pointer;transition:background-color 150ms,border-color 150ms,box-shadow 150ms,color 150ms;background:var(--main);color:var(--main-foreground);border:1px solid transparent;box-shadow:var(--shadow);}.ds-primary:hover{background:color-mix(in srgb,var(--main) 90%,transparent);}.ds-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-primary:active:not(:disabled){transform:translateY(1px);}.ds-primary:disabled{opacity:.5;pointer-events:none;}"
    },
