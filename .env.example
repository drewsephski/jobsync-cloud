# Runtime pooled Neon Postgres connection string (server-only).
DATABASE_URL=
# Optional direct connection for Prisma CLI; otherwise derived from DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Managed Neon Auth branch endpoint, including its /auth path (server-only).
NEON_AUTH_BASE_URL=
# Random secret with at least 32 characters; never use NEXT_PUBLIC_.
NEON_AUTH_COOKIE_SECRET=
