# Runtime pooled Neon Postgres connection string (server-only).
DATABASE_URL=
# Optional direct connection for Prisma CLI; otherwise derived from DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Managed Neon Auth branch endpoint, including its /auth path (server-only).
NEON_AUTH_BASE_URL=
# Random secret with at least 32 characters; never use NEXT_PUBLIC_.
NEON_AUTH_COOKIE_SECRET=
# Branch-scoped Object Storage credentials, pulled by neon env pull (server-only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Exact application origin for storage CORS (no path or trailing slash).
APP_ORIGIN=http://localhost:3000

# JobSync-owned server-only OpenRouter credential. Also supplied to resumeworker.
OPENROUTER_API_KEY=

# Exact comma-separated browser origins for private storage uploads (no wildcard).
# Keep localhost only while testing locally; include your canonical deployed origin.
STORAGE_ALLOWED_ORIGINS=https://jobsync-cloud.vercel.app
