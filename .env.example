# Runtime pooled Neon Postgres connection string (server-only).
DATABASE_URL=
# Optional direct connection for Prisma CLI; otherwise derived from DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Managed Neon Auth branch endpoint, including its /auth path (server-only).
NEON_AUTH_BASE_URL=
# Random secret with at least 32 characters; never use NEXT_PUBLIC_.
NEON_AUTH_COOKIE_SECRET=
# Branch-scoped Object Storage credentials, pulled by neon env pull (server-only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Exact application origin for storage CORS (no path or trailing slash).
APP_ORIGIN=http://localhost:3000

# Set false to disable the authenticated MCP endpoint. Enabled by default.
MCP_ENABLED=true

# JobSync-owned server-only OpenRouter credential. Also supplied to resumeworker.
OPENROUTER_API_KEY=

# Public invocation URL for the deployed discoveryworker, supplied by `neon functions get`.
DISCOVERY_WORKER_URL=
# Random server-only secret (at least 32 characters) shared with discoveryworker.
DISCOVERY_WAKE_SECRET=

# Exact comma-separated browser origins for private storage uploads (no wildcard).
# Keep localhost only while testing locally; include your canonical deployed origin.
STORAGE_ALLOWED_ORIGINS=https://jobsync-cloud.vercel.app

# Billing is disabled until configuration and test-mode lifecycle proof are complete.
# Core tracking/editing remains available during setup; AI/discovery stay bounded.
BILLING_ROLLOUT_READY=false
# Exactly test or live. Never point a live deployment at a test secret/price.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRODUCT_ID=
STRIPE_PLUS_PRICE_ID=
# Optional named portal configuration; enable payment method updates and cancellation.
STRIPE_PORTAL_CONFIGURATION_ID=

# Exact comma-separated isolated auth user IDs permitted to use deployed Stripe test billing.
# Keep empty for public users. Test subscriptions can never grant live-mode Plus.
BILLING_TEST_ALLOWED_USER_IDS=

# Public support details, provided by the operator
SUPPORT_EMAIL=
OPERATOR_NAME=
BILLING_LIVE_PROOF_ALLOWED_USER_IDS=
