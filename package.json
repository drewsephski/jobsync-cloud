{
  "name": "jobsync-cloud",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:smoke": "node --conditions=react-server --import tsx scripts/db-smoke.ts",
    "db:test": "node --conditions=react-server --import tsx --test tests/db-foundation.test.ts",
    "auth:test": "node --experimental-test-module-mocks --conditions=react-server --import tsx --test tests/auth-boundary.test.ts",
    "storage:configure": "node --conditions=react-server --import tsx scripts/configure-storage.ts",
    "storage:smoke": "node --conditions=react-server --import tsx scripts/storage-smoke.ts",
    "storage:test": "node --experimental-test-module-mocks --conditions=react-server --import tsx --test tests/storage.test.ts tests/storage-api.test.ts tests/storage-database.test.ts tests/storage-presigner.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/s3-request-presigner": "3.1144.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@next/env": "16.3.6",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "7.10.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^9",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4",
    "recharts": "^3",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.8.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
