generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResumeUploadStatus {
  pending
  uploaded
  rejected
  expired
}

enum ResumeVersionSource {
  manual
  upload
  import
}

enum ResumeVersionStatus {
  draft
  ready
  rejected
}

enum ProcessingRunStatus {
  pending
  running
  retry_wait
  succeeded
  failed
  canceled
}

enum AiUsageReservationStatus {
  reserved
  settled
  released
  reconciliation_required
}

enum AiUsageStatus {
  succeeded
  failed
  reconciliation_required
}

enum AccountDeletionStatus {
  completed
  pending
  running
  retry_wait
}

// Application-owned identity only; no dependency on Neon's managed auth schema.
model UserProfile {
  id                    String    @id
  displayName           String?
  timezone              String?
  onboardingCompletedAt DateTime? @db.Timestamptz(3)
  preferenceRevision    Int       @default(0)
  discoveryCursor       String?   @db.Uuid
  emailVerifiedAt       DateTime? @db.Timestamptz(3)
  trialStartedAt        DateTime? @db.Timestamptz(3)
  trialEndsAt           DateTime? @db.Timestamptz(3)
  discoveryInputKey     String?
  deletionRequestedAt   DateTime? @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  resumes           Resume[]
  resumeVersions    ResumeVersion[]
  resumeUploads     ResumeUpload[]
  targetPreferences TargetPreference[]
  processingRuns    ProcessingRun[]
  usageReservations AiUsageReservation[]
  aiUsage           AiUsage[]
  companyWatches CompanyWatch[]
  jobMatches JobMatch[]
  jobStates UserJobState[]
  applications Application[]
  billingCustomers BillingCustomer[]
  discoveryAllowances DiscoveryAllowance[]
}

model Resume {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String
  title       String
  confirmedVersionId String? @unique @db.Uuid
  confirmedAt DateTime? @db.Timestamptz(3)
  confirmedVersion ResumeVersion? @relation("ConfirmedResume", fields: [ownerUserId, id, confirmedVersionId], references: [ownerUserId, resumeId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  owner    UserProfile     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  versions ResumeVersion[]
  uploads  ResumeUpload[]

  // Used by the ownership-qualified version foreign key.
  @@unique([ownerUserId, id])
  @@index([ownerUserId, createdAt])
}

// Content is a snapshot: subsequent edits create a new version. Status can change.
model ResumeVersion {
  id               String              @id @default(uuid()) @db.Uuid
  ownerUserId      String
  resumeId         String              @db.Uuid
  version          Int
  source           ResumeVersionSource
  status           ResumeVersionStatus @default(draft)
  data             Json                @db.JsonB
  originDraftId    String? @db.Uuid
  originDraft ResumeVersion? @relation("DraftEdits", fields: [ownerUserId, resumeId, originDraftId], references: [ownerUserId, resumeId, id], onDelete: Restrict, onUpdate: Restrict)
  edits ResumeVersion[] @relation("DraftEdits")
  confirmedFor Resume[] @relation("ConfirmedResume")
  jobMatches JobMatch[]
  applications Application[]
  sourceUploadId   String?             @unique @db.Uuid
  processingRunId  String?             @unique @db.Uuid
  sourceSha256     String?             @db.VarChar(64)
  extractionVersion String?
  promptVersion    String?
  schemaVersion    String?
  sourceUpload ResumeUpload? @relation(fields: [ownerUserId, resumeId, sourceUploadId, sourceSha256], references: [ownerUserId, resumeId, id, contentSha256], onDelete: Restrict, onUpdate: Restrict)
  processingRun ProcessingRun? @relation(fields: [ownerUserId, processingRunId], references: [ownerUserId, id], onDelete: Restrict, onUpdate: Restrict)
  extractedText    String?
  storageObjectKey String?             @unique
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  owner  UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  resume Resume      @relation(fields: [ownerUserId, resumeId], references: [ownerUserId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([ownerUserId, resumeId, sourceUploadId, sourceSha256])
  @@unique([ownerUserId, processingRunId])
  @@unique([ownerUserId, resumeId, id])
  @@unique([resumeId, version])
  @@index([ownerUserId, resumeId])
}

model TargetPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  ownerUserId            String
  targetTitle            String
  location               String?
  remotePreferred        Boolean?
  minimumCompensationUsd BigInt?
  keywords               String[] @default([])
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, active])
}

model ProcessingRun {
  id                      String              @id @default(uuid()) @db.Uuid
  ownerUserId             String?
  // Open strings until the supported product operations are established.
  kind                    String
  resourceId              String
  // Globally unique, including service-owned runs. Callers must namespace keys.
  idempotencyKey          String              @unique
  status                  ProcessingRunStatus @default(pending)
  attempt                 Int                 @default(0)
  availableAt             DateTime            @default(now()) @db.Timestamptz(3)
  // A fresh token per claim; future workers must qualify all writes by this token.
  leaseToken              String?             @db.Uuid
  leaseExpiresAt          DateTime?           @db.Timestamptz(3)
  checkpoint              Json?               @db.JsonB
  cancellationRequestedAt DateTime?           @db.Timestamptz(3)
  startedAt               DateTime?           @db.Timestamptz(3)
  completedAt             DateTime?           @db.Timestamptz(3)
  errorCode               String?
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)

  draft ResumeVersion?
  @@unique([ownerUserId, id])

  owner UserProfile? @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, id])
  @@index([status, leaseExpiresAt, id])
  @@index([ownerUserId, status, createdAt])
  @@index([ownerUserId, kind, resourceId])
  @@index([kind, resourceId])
}

model AiUsageReservation {
  id                   String                   @id @default(uuid()) @db.Uuid
  ownerUserId          String
  feature              String
  provider             String?
  model                String?
  idempotencyKey       String                   @unique
  billingPeriodStart   DateTime?                @db.Timestamptz(3)
  billingPeriodEnd     DateTime?                @db.Timestamptz(3)
  // Internal integer units, with no promise of public credit weights.
  reservedUnits        BigInt
  reservedCostMicroUsd BigInt
  // Null means not yet reconciled; zero means reconciled with zero usage/cost.
  consumedUnits        BigInt?
  finalCostMicroUsd    BigInt?
  status               AiUsageReservationStatus @default(reserved)
  expiresAt            DateTime                 @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)

  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  usage AiUsage[]

  @@unique([ownerUserId, id])
  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([createdAt, status])
}

// One record per provider attempt (including retries); only reconciliation updates it.
model AiUsage {
  id                 String        @id @default(uuid()) @db.Uuid
  ownerUserId        String
  reservationId      String?       @db.Uuid
  feature            String
  provider           String
  model              String
  // Unique internal request ID per attempt; provider IDs are provider-scoped.
  requestId          String        @unique
  providerRequestId  String?
  pricingVersion     String?
  inputTokens        Int?
  outputTokens       Int?
  otherBillableUnits BigInt?
  costMicroUsd       BigInt?
  status             AiUsageStatus
  errorCode          String?
  // Operational metadata only, never prompts, resumes, or provider responses.
  metadata           Json?         @db.JsonB
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  owner       UserProfile         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  reservation AiUsageReservation? @relation(fields: [ownerUserId, reservationId], references: [ownerUserId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerUserId, createdAt])
  @@index([ownerUserId, reservationId])
  @@index([provider, providerRequestId])
}

// Transport lifecycle plus deterministic validation; no semantic resume facts.
enum ResumeDetectedFormat {
  pdf
  docx
}

model ResumeUpload {
  id                    String                @id @default(uuid()) @db.Uuid
  ownerUserId           String
  resumeId              String                @db.Uuid
  objectKey             String                @unique
  originalFileName      String                @db.VarChar(255)
  declaredContentType   String
  declaredSizeBytes     Int
  actualContentType     String?
  actualSizeBytes       BigInt?
  etag                  String?
  status                ResumeUploadStatus    @default(pending)
  expiresAt             DateTime              @db.Timestamptz(3)
  uploadedAt            DateTime?             @db.Timestamptz(3)
  validationCompletedAt DateTime?             @db.Timestamptz(3)
  detectedFormat        ResumeDetectedFormat?
  contentSha256         String?               @db.VarChar(64)
  rejectionCode         String?
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  draft ResumeVersion?
  @@unique([ownerUserId, resumeId, id, contentSha256])
  owner  UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  resume Resume      @relation(fields: [ownerUserId, resumeId], references: [ownerUserId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([ownerUserId, status, createdAt])
  @@index([status, expiresAt])
  @@index([status, validationCompletedAt, createdAt])
}

// Database-owned kill switch and starter allowances. Missing policy fails closed.
model AiBudgetPolicy {
  id String @id
  enabled Boolean @default(false)
  ownerMonthlyUnits BigInt
  ownerMonthlyCostMicroUsd BigInt
  globalDailyCostMicroUsd BigInt
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// Public catalog and ingestion are service-owned, never writable through user APIs.
enum AtsProvider {
  greenhouse
  lever
  ashby
}
model Company {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  boards AtsBoard[]
}
model AtsBoard {
  id String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  provider AtsProvider
  region String @default("global")
  slug String
  enabled Boolean @default(true)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  nextFetchAt DateTime @default(now()) @db.Timestamptz(3)
  errorCode String?
  fetchCount Int @default(0)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  postings JobPosting[]
  watches CompanyWatch[]
  @@unique([provider, slug])
  @@index([enabled, nextFetchAt])
}
model JobPosting {
  id String @id @default(uuid()) @db.Uuid
  boardId String @db.Uuid
  externalId String
  title String
  location String
  remote Boolean?
  description String
  originalUrl String
  publishedAt DateTime? @db.Timestamptz(3)
  contentHash String @db.VarChar(64)
  contentVersion Int @default(1)
  open Boolean @default(true)
  missingCount Int @default(0)
  firstSeenAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  board AtsBoard @relation(fields: [boardId], references: [id], onDelete: Restrict)
  matches JobMatch[]
  states UserJobState[]
  applications Application[]
  @@unique([boardId, externalId])
  @@index([boardId, open, firstSeenAt])
}
model CompanyWatch {
  ownerUserId String
  boardId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  board AtsBoard @relation(fields: [boardId], references: [id], onDelete: Restrict)
  @@id([ownerUserId, boardId])
  @@index([boardId])
}
enum DiscoveryState {
  new
  saved
  dismissed
}
// Actions survive recomputation; each user's state is independent of public jobs.
model UserJobState {
  ownerUserId String
  jobPostingId String @db.Uuid
  state DiscoveryState @default(new)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  posting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  @@id([ownerUserId, jobPostingId])
}
// Immutable input identity. Only AI result fields may be filled after dispatch.
model JobMatch {
  id String @id @default(uuid()) @db.Uuid
  ownerUserId String
  resumeId String @db.Uuid
  resumeVersionId String @db.Uuid
  preferenceRevision Int
  preferenceHash String @db.VarChar(64)
  jobPostingId String @db.Uuid
  postingVersion Int
  postingHash String @db.VarChar(64)
  algorithmVersion String
  inputKey String @unique
  relevance Int
  reasons String[]
  aiScore Int?
  recommendation String?
  rationale String?
  aiAnalyzedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  resumeVersion ResumeVersion @relation(fields: [ownerUserId, resumeId, resumeVersionId], references: [ownerUserId, resumeId, id], onDelete: Restrict, onUpdate: Restrict)
  posting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  @@unique([ownerUserId, id])
  @@index([ownerUserId, jobPostingId, createdAt])
}

// Private workflow: catalog links are optional; captured source identity is durable.
enum ApplicationStatus {
  saved
  applied
  interview
  offer
  rejected
  withdrawn
}

enum ApplicationEventKind {
  created
  transition
  archived
  restored
}

model Application {
  id               String             @id @default(uuid()) @db.Uuid
  ownerUserId      String
  jobPostingId     String?            @db.Uuid
  sourcePostingKey String?            @db.Uuid
  creationKey      String             @db.Uuid
  // Immutable original source and match metadata, separate from editable details.
  sourceSnapshot   Json               @db.JsonB
  company          String             @db.VarChar(200)
  title            String             @db.VarChar(200)
  location         String             @db.VarChar(300)
  postingUrl       String?            @db.VarChar(2000)
  salary           String?            @db.VarChar(200)
  notes            String?            @db.VarChar(10000)
  status           ApplicationStatus  @default(saved)
  stageName        String?            @db.VarChar(120)
  appliedOn        DateTime?          @db.Date
  followUpOn       DateTime?          @db.Date
  nextAction       String?            @db.VarChar(300)
  resumeId         String?            @db.Uuid
  resumeVersionId  String?            @db.Uuid
  resumeSnapshot   Json?              @db.JsonB
  revision         Int                @default(0)
  archivedAt       DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  owner            UserProfile        @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  posting          JobPosting?        @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  resumeVersion    ResumeVersion?     @relation(fields: [ownerUserId, resumeId, resumeVersionId], references: [ownerUserId, resumeId, id], onDelete: Restrict, onUpdate: Restrict)
  events           ApplicationEvent[]

  @@unique([ownerUserId, id])
  @@unique([ownerUserId, sourcePostingKey])
  @@unique([ownerUserId, creationKey])
  @@index([ownerUserId, archivedAt, status, updatedAt])
  @@index([ownerUserId, followUpOn])
}

model ApplicationEvent {
  id            String               @id @default(uuid()) @db.Uuid
  ownerUserId   String
  applicationId String               @db.Uuid
  revision      Int
  kind          ApplicationEventKind
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  stageName     String?              @db.VarChar(120)
  occurredOn    DateTime             @db.Date
  note          String?              @db.VarChar(2000)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  application   Application          @relation(fields: [ownerUserId, applicationId], references: [ownerUserId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([applicationId, revision])
  @@index([ownerUserId, createdAt])
}

// Billing provenance is application-owned and explicitly separated by Stripe mode.
model BillingCustomer {
  id String @id @default(uuid()) @db.Uuid
  ownerUserId String
  livemode Boolean
  stripeCustomerId String? @unique
  checkoutAttempt Int @default(0)
  checkoutSessionId String?
  checkoutUrl String?
  checkoutExpiresAt DateTime? @db.Timestamptz(3)
  reconciledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  subscriptions BillingSubscription[]
  @@unique([ownerUserId, livemode])
}
model BillingSubscription {
  stripeSubscriptionId String @id
  customerId String @db.Uuid
  stripePriceId String
  status String
  eligible Boolean @default(false)
  currentPeriodStart DateTime @db.Timestamptz(3)
  currentPeriodEnd DateTime @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean @default(false)
  stripeCreatedAt DateTime @db.Timestamptz(3)
  lastEventId String
  reconciledAt DateTime @db.Timestamptz(3)
  customer BillingCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  @@index([customerId, status])
}
// Stored only after a successful canonical reconciliation; failed work remains retryable.
model BillingWebhookEvent {
  id String @id
  livemode Boolean
  type String
  stripeCreatedAt DateTime @db.Timestamptz(3)
  customerId String?
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}
model DiscoveryAllowance {
  ownerUserId String
  periodStart DateTime @db.Timestamptz(3)
  scans Int @default(0)
  lastScannedAt DateTime @default(now()) @db.Timestamptz(3)
  owner UserProfile @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  @@id([ownerUserId, periodStart])
}

// Durable, retryable teardown ledger. Deliberately has no FK to UserProfile so
// cleanup can finish after the profile and Neon Auth identity are removed.
model AccountDeletionRequest {
  ownerUserId    String   @id
  requestedAt    DateTime @default(now()) @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  status         AccountDeletionStatus @default(pending)
  attempt        Int      @default(0)
  availableAt    DateTime @default(now()) @db.Timestamptz(3)
  leaseToken     String?  @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  errorCode      String?
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt, requestedAt])
  @@index([status, leaseExpiresAt])
}

// Content-free budget evidence survives private-data deletion. Unknown provider
// costs retain their conservative reservation so deleting an account cannot
// evade the global spend safeguard. No account, prompt, or resume identifiers.
model DeletedAccountAiBudget {
  id String @id @default(uuid()) @db.Uuid
  incurredAt DateTime @db.Timestamptz(3)
  reservedCostMicroUsd BigInt
  finalCostMicroUsd BigInt?
}
